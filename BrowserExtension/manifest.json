{
  "manifest_version": 3,
  "name": "Tibo Watch · X 直连",
  "version": "1.1.0",
  "description": "在本机读取 Tibo 主页和回复页的公开帖子，供 Tibo Watch 提前预警。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/thsottiaux",
        "https://x.com/thsottiaux/with_replies"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tibo Watch X 直连",
    "default_popup": "popup.html"
  }
}
